{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joplin Lite",
  "version": "0.1.0",
  "identifier": "com.kevinhao.joplin-lite",
  "build": {
    "beforeDevCommand": "yarn dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "yarn build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Joplin Lite",
        "width": 1180,
        "height": 760
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: joplin-resource:"
    }
  },
  "bundle": {
    "active": false
  }
}
