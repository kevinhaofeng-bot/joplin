[Unit]
Description=Joplin Lite HTTPS sync service
Requires=joplin-lite-docker.service
PartOf=joplin-lite-docker.service
After=joplin-lite-docker.service network-online.target
RequiresMountsFor=/volume1/Projects/joplin-lite-runtime

[Service]
Type=simple
ExecStart=/usr/bin/docker --host=unix:///run/joplin-lite-docker.sock run --rm --name joplin-lite-sync --network host --user 10001:10001 --read-only --cap-drop ALL --security-opt no-new-privileges --pids-limit 128 --memory 128m --memory-swap 128m --cpus 2 --tmpfs /tmp:rw,noexec,nosuid,size=8m --env-file /volume1/Projects/joplin-lite-runtime/secrets/server.env --mount type=bind,src=/volume1/Projects/joplin-lite-runtime/data,dst=/data --mount type=bind,src=/volume1/Projects/joplin-lite-runtime/tls,dst=/tls,readonly joplin-lite-server:acceptance-229
ExecStop=/usr/bin/docker --host=unix:///run/joplin-lite-docker.sock stop --time 20 joplin-lite-sync
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
