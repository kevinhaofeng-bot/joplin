[Unit]
Description=Encrypted Joplin Server backup to NAS restic repository
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/joplin-server/backup.env
ExecStart=/srv/joplin-server/scripts/backup.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/joplin-server
